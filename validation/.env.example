# Optional overrides for validation scripts.
# Copy to `.env` and edit, or export vars in your shell.

# Which build dirs to validate (comma-separated). If unset, auto-detect.
# ROCM_VALIDATION_BUILD_DIRS=build-stage2,build-stage1

# Override ROCm dist path for a build dir (rare).
# ROCM_VALIDATION_ROCM_DIST=/path/to/dist/rocm

# Disable network downloads (equivalent to `--no-downloads`).
# ROCM_VALIDATION_NO_DOWNLOADS=1

